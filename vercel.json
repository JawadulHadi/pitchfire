{
  "buildCommand": "pnpm --filter @pitchfire/shared build && pnpm --filter @pitchfire/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pitchfire-api.up.railway.app/:path*" }
  ]
}
