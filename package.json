    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "supabase": "^2.22.6",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "qs": ">=6.16.0",
    "braces": ">=3.0.3",
    "webpack": ">=5.104.1",
    "lodash": ">=4.18.1",
    "multer": ">=2.3.0",
    "postcss": ">=8.5.18"
  }
