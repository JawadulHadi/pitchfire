# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (voyage-3-lite embeddings — Phase 3)
# Get key at: https://dash.voyageai.com
VOYAGE_API_KEY=

# Supabase (local: http://localhost:54321)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (local: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Google OAuth (Gmail + Calendar — Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# NOTE: Per-user access tokens are stored in Supabase user_google_tokens table.
# The GMAIL_ACCESS_TOKEN and GOOGLE_CALENDAR_ACCESS_TOKEN env vars are no longer
# used — tokens are fetched/refreshed at runtime via google-tokens.ts helper.

# Stripe (Phase 5 — billing)
# Create products + prices at: https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for Pro and Agency plans (from Stripe dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Public Stripe key for frontend (optional — for Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# App URLs (local dev)
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production (Railway + Vercel)
# WEB_URL=https://pitchfire.vercel.app
# API_URL=https://pitchfire-api.up.railway.app
# NEXT_PUBLIC_API_URL=https://pitchfire-api.up.railway.app

# Optional: Slack webhook for notifications (Phase 4)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Bull Board admin UI (Phase 4)
# Set any strong token — required in X-Admin-Token header to access /admin/queues
ADMIN_TOKEN=

# ApplierAgent profile fields (fetched from users table once Supabase auth is wired)
USER_FIRST_NAME=
USER_LAST_NAME=
USER_PHONE=
USER_LOCATION=Remote

# Notion pipeline sync
# Get database ID from your Notion database URL:
#   notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=
