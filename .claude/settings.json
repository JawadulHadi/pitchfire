{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=utsgtujqdljagnkokydg&read_only=false&features=docs,account,database,debugging,development,functions,branching"
    },
    "pitchfire": {
      "type": "stdio",
      "command": "node",
      "args": ["apps/mcp-server/dist/index.js"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
        "REDIS_URL": "${REDIS_URL}",
        "API_URL": "${API_URL}"
      }
    }
  }
}
